__pycache__/
*.pyc
.venv/
.DS_Store

# training outputs — checkpoints are ~100MB each, never commit them
out/
# top-level run folders only, so evals/out-*/ results stay trackable
/out-*/
*.pt
*.ckpt
*.npy

# experiment logs
wandb/
runs/

# tokenized datasets — regenerate with data/<dataset>/prepare.py
*.bin
*.npy
.prepare_checkpoint.json
**/data/**/input.txt

# internal build-tracking docs — not portfolio content
LEARNING_PLAN.md
TRAINING_COST_GUIDE.md
S1_REQUIREMENTS.md
RUNPOD_RUNBOOK.md

# snapshots of the internal docs above, taken before restructuring them
docs-archive/

# eval results are kept (re-included past the parent repo's out-*/ rule); per-example samples are large and
# regenerable
!evals/**/out-*/
evals/**/samples_*.jsonl

# blog draft and its scratch scripts/figures 
Blog[0-9]*_*.md
blog_scratch/
